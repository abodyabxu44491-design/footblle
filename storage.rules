rules_version = '2';
// قواعد أمان Firebase Storage لصور اللاعبين
// ضعها في: Firebase Console → Storage → Rules → Publish
service firebase.storage {
  match /b/{bucket}/o {
    // صور اللاعبين: القراءة للجميع (كي تظهر للجمهور)،
    // والكتابة/الحذف للمستخدمين المسجّلين فقط (المنظّمون).
    match /players/{teamId}/{playerId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // مقاطع الإعادة: القراءة للجميع (ليشاهدها الجمهور)، الرفع للمنظّمين المسجّلين.
    // مقاطع قصيرة (~15 ثانية) بحدّ 25MB.
    match /replays/{streamId}/{clip} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }
  }
}
