rules_version = '2';
// قواعد أمان Firebase Storage — صور اللاعبين ومقاطع الإعادة
//
// 🔴 v339 — كانت الكتابة والحذف لـ «أي مستخدم مسجّل» (request.auth != null).
//    وكل منظّم بطولة مسجّل، فأي منظّم يحذف أو يستبدل صور لاعبي بطولة
//    غيره ومقاطع إعادتها. الآن يُربط كل ملف ببطولته عبر Firestore:
//      • صور اللاعبين: الفريق {teamId} يجب أن يكون في بطولة المنظّم.
//      • الإعادات: {streamId} = "{leagueId}__{matchId}" — البادئة بطولته.
//    ⚠️ هذه «قواعد عابرة للخدمات» (firestore.get داخل Storage): عند أول
//       نشر يطلب Firebase منح Storage صلاحية قراءة Firestore — وافق.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }

    function myLeague() {
      return firestore.exists(/databases/(default)/documents/leagueAdmins/$(request.auth.uid))
             ? firestore.get(/databases/(default)/documents/leagueAdmins/$(request.auth.uid)).data.get('leagueId', '')
             : '';
    }

    function isSuperAdmin() {
      return firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'superadmin';
    }

    function ownsTeam(teamId) {
      return myLeague() != ''
             && firestore.exists(/databases/(default)/documents/leagues/$(myLeague())/teams/$(teamId));
    }

    // صور اللاعبين: القراءة للجميع (كي تظهر للجمهور)
    match /players/{teamId}/{playerId} {
      allow read: if true;
      allow write: if signedIn()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && (ownsTeam(teamId) || isSuperAdmin());
      allow delete: if signedIn() && (ownsTeam(teamId) || isSuperAdmin());
    }

    // مقاطع الإعادة: القراءة للجميع، الرفع لمذيع البطولة. مقاطع قصيرة بحدّ 25MB.
    match /replays/{streamId}/{clip} {
      allow read: if true;
      allow write: if signedIn()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*')
                   && (streamId.split('__')[0] == myLeague() || isSuperAdmin());
      allow delete: if signedIn() && (streamId.split('__')[0] == myLeague() || isSuperAdmin());
    }
  }
}
